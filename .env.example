# Browser-safe Supabase configuration
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
VITE_API_BASE_URL=http://127.0.0.1:8000

# FastAPI server-only configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-secret-key
INTERNAL_API_TOKEN=generate-a-long-random-value
INTERNAL_FUNCTION_TOKEN=generate-a-separate-long-random-value
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173

# Local E2E user setup. Passwords are generated per environment and never committed.
E2E_ADMIN_EMAIL=admin@atlas-automation.test
E2E_ADMIN_PASSWORD=replace-with-a-random-local-value
E2E_SECOND_ORG_EMAIL=owner@northstar-workflow.test
E2E_SECOND_ORG_PASSWORD=replace-with-a-different-random-local-value
